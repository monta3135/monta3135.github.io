---
import kmcLogo from "../assets/KMClogo_mini.png";
import juiceBanner from "../assets/juice-banner.svg";
import youtubeBanner from "../assets/youtube-banner.svg";

interface Props {
  href: string;
  variant: "kmc" | "youtube" | "juice";
  ariaLabel: string;
}

const { href, variant, ariaLabel } = Astro.props;
---

<a
  class:list={["web-badge", `web-badge--${variant}`]}
  href={href}
  aria-label={ariaLabel}
>
  {
    variant === "kmc" ? (
      <img
        class="kmc-logo"
        src={kmcLogo.src}
        alt=""
        width="120"
        height="77"
        aria-hidden="true"
        decoding="async"
      />
    ) : variant === "youtube" ? (
      <img
        class="web-badge-image"
        src={youtubeBanner.src}
        alt=""
        width="88"
        height="31"
        aria-hidden="true"
        decoding="async"
      />
    ) : (
      <img
        class="web-badge-image"
        src={juiceBanner.src}
        alt=""
        width="88"
        height="31"
        aria-hidden="true"
        decoding="async"
      />
    )
  }
</a>

<style>
  .web-badge {
    display: inline-flex;
    position: relative;
    width: var(--web-badge-width);
    min-width: var(--web-badge-width);
    height: var(--web-badge-height);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid var(--badge-border);
    border-radius: 0;
    background-color: var(--badge-bg);
    box-shadow:
      inset 1px 1px 0 var(--badge-light),
      inset -1px -1px 0 var(--badge-dark);
    color: var(--badge-text);
    font-family: var(--font-mono);
    line-height: 1;
    text-decoration: none;
    transition:
      background-color var(--transition),
      border-color var(--transition),
      color var(--transition);
  }

  .web-badge:hover {
    border-color: var(--badge-hover-border);
    background-color: var(--badge-hover-bg);
    color: var(--badge-hover-text);
  }

  .web-badge:active {
    transform: translateY(1px);
  }

  .web-badge:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .kmc-logo {
    display: block;
    width: auto;
    height: 86%;
    max-width: 94%;
    object-fit: contain;
  }

  .web-badge--kmc {
    --badge-bg: #fff;
    --badge-border: #151813;
    --badge-dark: #87917c;
    --badge-hover-bg: #f0f5ec;
    --badge-hover-border: #30392a;
    --badge-hover-text: #151813;
    --badge-light: #fff;
    --badge-text: #151813;
  }

  .web-badge--youtube,
  .web-badge--juice {
    width: 88px;
    min-width: 88px;
    height: 31px;
    border: 0;
    background: transparent;
    box-shadow: none;
    transition: filter var(--transition);
  }

  .web-badge-image {
    display: block;
    width: 88px;
    height: 31px;
    image-rendering: crisp-edges;
  }

  .web-badge--youtube:hover,
  .web-badge--juice:hover {
    background: transparent;
    filter: brightness(1.08) saturate(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .web-badge {
      transition: none;
    }

    .web-badge--youtube,
    .web-badge--juice {
      transition: none;
    }
  }
</style>
