---
import profileImage from "@/assets/favicon.jpg";
import profileBackgroundImage from "@/assets/profile-cat-transparent.png";
import DitheredObject from "@/components/canvasui/DitheredObject";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";

const birthDate = new Date("2005-02-10");
---

<BaseLayout title="Profile" description="monta3135 について">
  <article class="prose max-w-none profile-page">
    <DitheredObject
      client:load
      className="profile-background"
      src={profileBackgroundImage.src}
      method="bayer"
      gridSize={6}
      grayscale={true}
      scale={4}
      orbit={false}
      zoom={false}
      autoRotate={false}
      floatIntensity={0.8}
      rotationIntensity={0.3}
      style={{
        position: "fixed",
        inset: 0,
        zIndex: 0,
        pointerEvents: "none",
        opacity: 0.28,
      }}
    />

    <h1 class="profile-page-title">Profile</h1>

    <section class="not-prose mt-8 space-y-8">
      <div class="profile-card">
        <div class="profile-card-inner sm:flex sm:items-start sm:gap-8">
          <div class="shrink-0">
            <img
              src={profileImage.src}
              alt="monta3135's profile image"
              width={160}
              height={160}
              loading="eager"
              decoding="async"
              class="mx-auto h-32 w-32 rounded-full object-cover shadow-sm ring-1 ring-zinc-200 sm:mx-0 sm:h-40 sm:w-40 dark:ring-zinc-700"
            />
          </div>

          <div class="mt-6 text-center sm:mt-0 sm:text-left">
            <h2 class="profile-card-title text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              monta3135
            </h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-800 dark:text-zinc-200">
              Hi! I’m monta (<FormattedDate date={birthDate} format="age" />). I'm a second-year undergraduate student at Kansai University majoring in Computer Science.
            </p>

            <div class="mt-6 flex flex-wrap justify-center gap-4 sm:justify-start">
              <a
                href="https://twitter.com/monta3135"
                class="inline-flex items-center justify-center rounded-full bg-zinc-900 px-6 py-2.5 text-sm font-medium text-white transition-colors hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
              >
                Twitter
              </a>
              <a
                href="https://github.com/monta3135"
                class="inline-flex items-center justify-center rounded-full border border-zinc-200 bg-white px-6 py-2.5 text-sm font-medium text-zinc-900 transition-colors hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700"
              >
                GitHub
              </a>
            </div>
          </div>
        </div>
      </div>

      <section class="skills-card transition-all hover:shadow-md">
        <h3 class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Skills</h3>
        <div class="mt-5 flex flex-wrap items-center gap-2">
          <span class="skill-tag inline-flex items-center px-4 py-2 text-sm font-medium">
            C
          </span>
          <span class="skill-tag inline-flex items-center px-4 py-2 text-sm font-medium">
            C++
          </span>
          <span class="skill-tag inline-flex items-center px-4 py-2 text-sm font-medium">
            Python
          </span>
        </div>
      </section>
    </section>
  </article>
</BaseLayout>

<style>
  .profile-card {
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--bg) 40%, transparent);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    transition: border-color var(--transition), transform var(--transition),
      box-shadow var(--transition);
  }

  .profile-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .profile-card-inner {
    padding: var(--spacing-xl);
  }

  .skills-card {
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: var(--spacing-xl);
    background: color-mix(in srgb, var(--bg) 45%, transparent);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .skill-tag {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-secondary) 60%, transparent);
    color: var(--text);
  }

  .profile-page-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.2;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .profile-card-title {
    transition: color var(--transition);
  }

  .profile-card:hover .profile-card-title {
    color: var(--accent);
  }

  .profile-page > :not(.profile-background) {
    position: relative;
    z-index: 1;
  }

  .profile-page a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-page .profile-background {
      opacity: 0.12 !important;
    }

    .profile-page .profile-card,
    .profile-page .skills-card,
    .profile-page .profile-card-title {
      transition: none;
    }
  }

</style>
