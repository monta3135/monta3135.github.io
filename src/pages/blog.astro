---
import { getCollection } from "astro:content";
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Articles" description="monta のブログ">
  <div class="blog-page">
    <section class="hero">
      <h1 class="hero-title">Articles</h1>
    </section>

    <section class="posts-section" aria-label="記事一覧">
      {posts.length === 0 ? (
        <p class="empty-state">記事がまだありません。</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .blog-page {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3xl);
  }

  .hero {
    padding-block: var(--spacing-xl) var(--spacing-lg);
    border-bottom: 1px solid var(--border);
  }

  .hero-title {
    margin: 0;
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
    text-wrap: balance;
  }

  .hero-desc {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
  }

  .posts-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .empty-state {
    color: var(--text-muted);
    text-align: center;
    padding: 3rem 0;
    font-size: var(--text-sm);
    font-family: var(--font-mono);
  }

  .blog-page a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-page a,
    .blog-page .post-card {
      transition: none;
    }
  }
</style>
