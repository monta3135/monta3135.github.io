---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import BaseLayout from "./BaseLayout.astro";

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<"blog">;
  tocHeadings?: TocHeading[];
}

const { post, tocHeadings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, categories } = post.data;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const hasToc = tocHeadings.length > 0;
const minTocDepth = hasToc
  ? Math.min(...tocHeadings.map((heading) => heading.depth))
  : 0;

// Generate the URL for the static OG image endpoint
const ogImageURL = new URL(
  `${baseUrl}og/${post.id}.png`,
  Astro.site,
).toString();
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={ogImageURL}
  ogImageAlt={title}
>
  <div class="post-layout">
    {
      hasToc && (
        <aside class="post-toc">
          <nav class="post-toc-inner" aria-label="目次" data-post-toc data-toc-mode="progress">
            <div class="toc-header">
              <p class="toc-title">目次</p>
            </div>

            <div class="toc-panel toc-panel--progress" data-toc-panel="progress">
              <ol class="toc-list toc-list--progress">
                {tocHeadings.map((heading, index) => (
                  <li
                    class="toc-progress-item"
                    style={`--toc-level: ${Math.max(0, heading.depth - minTocDepth)}`}
                    data-toc-progress-item
                    data-toc-index={index}
                  >
                    <a href={`#${heading.slug}`} class="toc-link" data-toc-link data-toc-id={heading.slug}>
                      <span class="toc-item-label">{heading.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </nav>
        </aside>
      )
    }

    <article class="post-article">
      <header class="post-header">
        <div class="post-meta">
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <span class="updated-date">
                — <FormattedDate date={updatedDate} /> 更新
              </span>
            )
          }
        </div>

        <h1 class="post-title">{title}</h1>

        {
          categories.length > 0 && (
            <div class="post-categories">
              {categories.map((cat) => (
                <a href={`${baseUrl}categories/${cat}`} class="tag">{cat}</a>
              ))}
            </div>
          )
        }
      </header>

      <div class="prose post-body">
        <slot />
      </div>

      <footer class="post-footer">
        <a href={`${import.meta.env.BASE_URL}`}>← 一覧へ戻る</a>
      </footer>
    </article>
  </div>

  {
    hasToc && (
      <script is:inline>
        const tocRoot = document.querySelector("[data-post-toc]");
        if (tocRoot instanceof HTMLElement) {
          const links = Array.from(tocRoot.querySelectorAll("a[data-toc-link]"));
          const headingElements = Array.from(
            new Map(
              links
                .map((link) => {
                  const id = link.getAttribute("data-toc-id");
                  const heading = id ? document.getElementById(id) : null;
                  return heading instanceof HTMLElement ? [heading.id, heading] : null;
                })
                .filter((entry) => entry !== null),
            ).values(),
          );
          const progressItems = Array.from(tocRoot.querySelectorAll("[data-toc-progress-item]"));

          if (links.length > 0 && headingElements.length > 0) {
            const activeOffset = 120;

            const setActiveLink = (id) => {
              const activeIndex = Math.max(
                0,
                headingElements.findIndex((heading) => heading.id === id),
              );

              for (const link of links) {
                const linkIndex = headingElements.findIndex(
                  (heading) => heading.id === link.getAttribute("data-toc-id"),
                );
                const state = linkIndex < activeIndex ? "read" : linkIndex === activeIndex ? "current" : "upcoming";
                link.dataset.tocState = state;
                if (state === "current") {
                  link.setAttribute("aria-current", "location");
                } else {
                  link.removeAttribute("aria-current");
                }
              }

              for (const item of progressItems) {
                const itemIndex = Number(item.getAttribute("data-toc-index"));
                item.dataset.tocState = itemIndex < activeIndex ? "read" : itemIndex === activeIndex ? "current" : "upcoming";
              }

              const activeLink = links.find((link) => link.getAttribute("data-toc-id") === id);
              if (activeLink instanceof HTMLElement) {
                activeLink.scrollIntoView({ block: "nearest" });
              }
            };

            const syncActiveHeading = () => {
              let activeId = headingElements[0].id;
              const isAtPageBottom =
                window.scrollY + window.innerHeight >=
                document.documentElement.scrollHeight - 2;

              if (isAtPageBottom) {
                activeId = headingElements[headingElements.length - 1].id;
              } else {
                for (const heading of headingElements) {
                  if (heading.getBoundingClientRect().top <= activeOffset) {
                    activeId = heading.id;
                  } else {
                    break;
                  }
                }
              }
              setActiveLink(activeId);
            };

            let ticking = false;
            const onScroll = () => {
              if (ticking) {
                return;
              }
              ticking = true;
              window.requestAnimationFrame(() => {
                syncActiveHeading();
                ticking = false;
              });
            };

            syncActiveHeading();
            document.addEventListener("scroll", onScroll, { passive: true });
            window.addEventListener("resize", syncActiveHeading);
          }
        }
      </script>
    )
  }
</BaseLayout>

<style>
  :global(main.container) {
    max-width: min(1400px, 100%);
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "toc"
      "content";
    gap: 1.75rem;
  }

  .post-article {
    grid-area: content;
    min-width: 0;
    max-width: 760px;
    width: 100%;
    margin-inline: auto;
  }

  .post-toc {
    grid-area: toc;
    align-self: start;
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
  }

  .post-toc-inner {
    transition: background-color var(--transition), border-color var(--transition), box-shadow var(--transition);
  }

  .post-toc-inner[data-toc-mode="progress"] {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    padding: 0.3rem 0;
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .toc-title {
    color: var(--text);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-link {
    display: block;
    min-width: 0;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.45;
    padding: 0.22rem 0;
    border-radius: 0;
    transition: color var(--transition), opacity var(--transition);
    text-wrap: pretty;
  }

  .toc-item-label {
    min-width: 0;
  }

  .toc-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .toc-list--progress {
    display: grid;
    gap: 0.04rem;
  }

  .toc-progress-item {
    display: block;
    margin-left: calc(var(--toc-level) * 1.2rem);
  }

  .toc-list--progress .toc-link {
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.45;
    padding: 0.2rem 0;
    transition: color var(--transition), opacity var(--transition);
  }

  .toc-list--progress .toc-link[data-toc-state="upcoming"] {
    color: color-mix(in srgb, var(--accent) 42%, var(--bg));
    opacity: 1;
  }

  .toc-list--progress .toc-link[data-toc-state="read"] {
    color: var(--accent);
    font-weight: 700;
  }

  .toc-list--progress .toc-link[aria-current="location"] {
    color: var(--accent);
    font-weight: 700;
  }

  .toc-list--progress .toc-link:hover {
    color: color-mix(in srgb, var(--accent) 78%, var(--text));
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .post-meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-bottom: 0.75rem;
  }

  .updated-date {
    margin-left: 0.25rem;
  }

  .post-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .post-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .post-body {
    margin-top: 2rem;
  }

  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .post-footer a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .post-footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 1023px) {
    .post-layout {
      gap: 1.25rem;
    }

    .post-toc-inner {
      padding: 0.75rem 0.875rem;
    }

    .toc-link {
      min-height: 2.75rem;
      display: flex;
      align-items: center;
      padding-block: 0.45rem;
    }

    .post-body :global(pre),
    .post-body :global(.expressive-code) {
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .post-body :global(table) {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .post-body :global(a) {
      overflow-wrap: anywhere;
    }
  }

  @media (max-width: 639px) {
    .post-layout {
      gap: 1rem;
    }

    .post-toc-inner {
      padding: 0.65rem 0.75rem;
    }

    .toc-link {
      font-size: var(--text-xs);
      line-height: 1.4;
      padding-inline: 0.15rem 0.35rem;
    }

    .post-header {
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
    }

    .post-meta {
      line-height: 1.6;
    }

    .updated-date {
      display: block;
      margin-left: 0;
    }

    .post-body {
      margin-top: 1.5rem;
    }

    .post-body :global(pre) {
      padding: 0.75rem;
    }
  }

  @media (min-width: 1024px) {
    .post-layout {
      grid-template-columns: minmax(0, 760px) minmax(18rem, 22rem);
      grid-template-areas: "content toc";
      justify-content: center;
      gap: 2.25rem;
      align-items: start;
    }

    .post-toc {
      position: sticky;
      top: calc(var(--header-height) + 1rem);
    }

    .post-toc-inner {
      max-height: calc(100dvh - var(--header-height) - 2rem);
      overflow: auto;
    }

    .post-toc-inner[data-toc-mode="progress"] {
      padding-right: 0.25rem;
    }
  }

  @media (min-width: 1360px) {
    .post-layout {
      grid-template-columns: 16rem minmax(0, 760px) 21rem;
      gap: 2rem;
    }

    .post-article {
      grid-column: 2;
      max-width: none;
    }

    .post-toc {
      grid-column: 3;
    }
  }

  @media (max-width: 1023px) {
    .post-toc-inner[data-toc-mode="progress"] {
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.25rem;
    }

    .toc-panel {
      max-width: 42rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-link {
      transition: none;
    }
  }
</style>
